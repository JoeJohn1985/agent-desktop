{
  "name": "agent-desktop",
  "version": "1.27.1",
  "description": "Agent Desktop — lokale Agent-Anwendung für mehrere LLM-Provider (GitHub Copilot CLI, Claude Code, Anthropic, Gemini, OpenAI, Ollama, GLM)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "rebuild": "electron-rebuild",
    "build": "electron-builder --dir",
    "smoke:claude-runtime": "node src/claude-runtime-smoke.js",
    "test": "jest",
    "test:verbose": "jest --verbose",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "eslint . && jest",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "author": "MSchneider",
  "license": "Apache-2.0",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "electron": "^43.2.0",
    "electron-builder": "26.18.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jest": "^30.3.0"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.97.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@anthropic-ai/sdk": "^0.105.0",
    "@google/genai": "^2.10.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "dompurify": "^3.4.1",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.2",
    "yaml": "^2.7.0"
  },
  "build": {
    "appId": "dev.agent-desktop",
    "asar": true,
    "afterPack": "./src/claude-runtime-after-pack.js",
    "asarUnpack": [
      "node_modules/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "assets/**",
      "vendor/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
