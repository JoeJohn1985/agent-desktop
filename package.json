{
  "name": "copilot-desktop",
  "version": "0.28.10",
  "description": "Desktop-App für GitHub Copilot CLI mit JSON-basierter Kommunikation",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "rebuild": "electron-rebuild",
    "test": "jest",
    "test:verbose": "jest --verbose",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "eslint . && jest",
    "pack:portable": "electron-builder --win dir",
    "dist:portable": "pwsh -NoProfile -ExecutionPolicy Bypass -File build/portable/build-portable.ps1"
  },
  "build": {
    "appId": "de.gebit.copilot-desktop",
    "productName": "copilot-desktop",
    "asar": true,
    "npmRebuild": false,
    "icon": "assets/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "renderer/**",
      "src/**",
      "assets/**",
      "images/**",
      "docs/**",
      "node_modules/**/*",
      "!**/{__tests__,test,tests,spec}/**",
      "!**/*.{md,markdown}",
      "!**/.bin/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/icon.png"
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  },
  "author": "MSchneider",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jest": "^30.3.0"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "dompurify": "^3.4.1",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.2",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "yaml": "^2.7.0"
  }
}
