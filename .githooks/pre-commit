#!/bin/sh
# Pre-commit hook: Run ESLint (syntax + static analysis) and Jest tests before every commit.
# If either fails, the commit is aborted.
#
# This file is versioned. Git is pointed at this directory via core.hooksPath,
# which the "prepare" script in package.json sets up on every `npm install` —
# so a fresh clone gets the hook automatically instead of silently committing
# without any checks (which is what happened while it lived in .git/hooks).

echo "🔍 Running ESLint..."
cd "$(git rev-parse --show-toplevel)"
LINT_OUTPUT=$(npx eslint . 2>&1)

if [ $? -ne 0 ]; then
  echo "$LINT_OUTPUT"
  echo ""
  echo "❌ ESLint failed — commit aborted."
  echo "   Fix the lint errors and try again."
  exit 1
fi

echo "✅ ESLint passed."
echo "🧪 Running tests before commit..."
OUTPUT=$(npx jest --no-coverage 2>&1)

if [ $? -ne 0 ]; then
  echo "$OUTPUT"
  echo ""
  echo "❌ Tests failed — commit aborted."
  echo "   Fix the failing tests and try again."
  exit 1
fi

echo "✅ All tests passed."
